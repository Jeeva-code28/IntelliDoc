# ==============================================================================
# Project NPN Multimodal QA Chatbot - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual API credentials.
# NEVER commit the active '.env' file containing real secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# LLM Provider Selection
# ------------------------------------------------------------------------------
# Active default provider: "gemini", "groq", "ollama", or "openai"
DEFAULT_LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Local Ollama Inference (Qwen 9B Opus Agent)
# ------------------------------------------------------------------------------
# The local Ollama model identifier installed on the host
OLLAMA_MODEL=hf.co/armand0e/Qwen3.5-9B-Opus-Agent-GGUF:Q5_K_M
# Ollama OpenAI-compatible REST endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
# Request timeout in seconds for local GGUF model generation
OLLAMA_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# Google Gemini Provider
# ------------------------------------------------------------------------------
# Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model identifier (e.g. gemini-flash-latest, gemini-1.5-flash)
GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# Groq Cloud Provider
# ------------------------------------------------------------------------------
# Groq API Key (obtain from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
# Fallback alias for Groq key
GROK_API_KEY=your_groq_api_key_here
# Groq model identifier (e.g. llama-3.3-70b-versatile, llama3-70b-8192)
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# OpenAI Provider (Optional)
# ------------------------------------------------------------------------------
# OpenAI API Key (obtain from https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Embedding Model & Vector Retrieval Settings
# ------------------------------------------------------------------------------
# Local HuggingFace sentence transformer embedding model
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Embedding vector dimension (384 for bge-small-en-v1.5)
EMBEDDING_DIM=384
